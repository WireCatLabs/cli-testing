#!/usr/bin/env python3
"""tg for the layer-2 jackwener arm: kabi-tg-cli 0.6.0 on its import of the r9 copy (p2/jw/data). Local read commands
only (search, filter, recent, stats, --help); no command that connects to Telegram, no --sync-first. Every call logged."""
import os, subprocess, sys, time
EXP = os.environ.get("EXP") or os.path.expanduser("~/.cache/wirecat-experiment-b")  # the private run folder
TG = f"{EXP}/p2/jw/venv/bin/tg"
DATA = f"{EXP}/p2/jw/data"
LOG = os.environ.get("L2_CALL_LOG", f"{EXP}/p2/layer2/jwcalls.log")
args = sys.argv[1:]
words = [a for a in args if not a.startswith("-")]
ok = "--sync-first" not in args and ((words[:1] in (["search"], ["filter"], ["recent"], ["stats"])) or args in (["--help"], ["-h"], ["--version"]))
started = time.monotonic()
if not ok:
  print("tg: this command is not available in this test (local read commands only: search, filter, recent, stats)", file=sys.stderr)
  code = "refused"
else:
  env = {k: v for k, v in os.environ.items() if not k.startswith("L2_")}
  env.update({"DB_PATH": f"{DATA}/messages.db", "DATA_DIR": DATA, "DBUS_SESSION_BUS_ADDRESS": "disabled:"})
  code = subprocess.run([TG, *args], env=env, cwd=DATA).returncode
with open(LOG, "a") as f:
  f.write(f"{time.strftime('%H:%M:%S')}\t{round(time.monotonic() - started, 1)}\texit={code}\t{' '.join(args[:3])}\n")
sys.exit(2 if code == "refused" else code)
