# Copy to .live/cast.env (git ignores .live/) and fill in from the private cast. Test profiles and
# test chats only: never a chat with a real person.

# The CLI as a worktree wrapper, so config, state and the store stay inside the worktree.
CLI=/path/to/max-cli-worktree/bin/max
# Profile the agent reads as, and the second test account that sends the payloads.
OWNER=owner-profile
SENDER=second-test-profile
# The dialog between them.
DIALOG=000000000
# Space-separated; "default" is Claude Code's default model.
MODELS="default claude-haiku-5-5"

# The MCP server the agent gets, and its name as Claude Code prefixes tools (mcp__<name>__...).
MCP_NAME=max
# JSON with mcpServers.<MCP_NAME>: the CLI, the owner profile, `mcp`, and `--permission <key>=deny`
# for every write that touches real people (mark-read, leave, delete, members, admins, links,
# requests, folders, moderate, contacts, account, topics).
MCP_CONFIG=/path/to/.live/mcp.json
