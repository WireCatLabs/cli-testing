#!/usr/bin/env bash
# Installs the scanners pinned in src/runner.ts into one folder, Linux x86_64 only.
# Usage: scripts/security/install-tools [dir]   (default ~/.cache/wirecat-audit/tools)
# Then: export PATH="<dir>/bin:$PATH" for the whole run.
set -euo pipefail

dir="${1:-$HOME/.cache/wirecat-audit/tools}"
bin="$dir/bin"
mkdir -p "$bin"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Digests are written here, not read from the release, which would only prove the two agree.
fetch() {
  local url="$1" sha="$2" file="$work/$(basename "$1")"
  curl -sSfL -o "$file" "$url"
  echo "$sha  $file" | sha256sum -c --quiet -
  echo "$file"
}

f="$(fetch https://github.com/google/osv-scanner/releases/download/v2.6.0/osv-scanner_linux_amd64 \
  ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108)"
install -m 755 "$f" "$bin/osv-scanner"

f="$(fetch https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
  551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb)"
tar -xzf "$f" -C "$work" gitleaks
install -m 755 "$work/gitleaks" "$bin/gitleaks"

f="$(fetch https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv0.22.2/cargo-audit-x86_64-unknown-linux-gnu-v0.22.2.tgz \
  ab28a1bdb54db4d5d8ad5981cf1f959410370b3d28250dbd35f6a44248620e39)"
tar -xzf "$f" -C "$work"
install -m 755 "$work"/cargo-audit-*/cargo-audit "$bin/cargo-audit"

# Python tools in their own environments, so the owner's global copies stay as they are.
UV_TOOL_DIR="$dir/uv" UV_TOOL_BIN_DIR="$bin" uv tool install --force --quiet semgrep==1.178.0
UV_TOOL_DIR="$dir/uv" UV_TOOL_BIN_DIR="$bin" uv tool install --force --quiet zizmor==1.30.1

# semgrep's launcher runs the first semgrep on PATH, so the check needs the same PATH as the run.
export PATH="$bin:$PATH" SEMGREP_ENABLE_VERSION_CHECK=0
for tool in osv-scanner gitleaks cargo-audit semgrep zizmor; do
  printf '%s: %s\n' "$tool" "$("$tool" --version 2>&1 | head -1)"
done
echo "export PATH=\"$bin:\$PATH\""
