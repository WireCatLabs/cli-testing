{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!.claude/settings.json",
      "!**/.worktrees",
      "!config/wirecat"
    ],
    "maxSize": 16777216
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@wirecat/cli-messaging*",
                      "@wirecat/cli-messaging*/**",
                      "@wirecat/cli-messaging*",
                      "@wirecat/cli-messaging*/**",
                      "@mtcute/*",
                      "ws",
                      "**/telegram/**",
                      "**/max/**"
                    ],
                    "message": "cli-testing drives a CLI through its binary and its MCP server, never its code: what a CLI needs is config in that CLI's repository"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["performance/search/message-search/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "performance/search/matrix/results/**",
        "performance/search/matrix/fresh.json",
        "performance/search/matrix/models/**",
        "performance/search/validation/results/**",
        "performance/search/validation/fixture.json",
        "performance/search/model-free/results/**",
        "performance/search/model-free/fixture.json",
        "performance/search/model-free/fresh.json"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
