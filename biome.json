{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@leemour/cli-core/biome"],
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!pnpm-lock.yaml", "!.claude/settings.json"],
    "maxSize": 8388608
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@leemour/cli-messaging*",
                      "@leemour/cli-messaging*/**",
                      "@wirecat/cli-messaging*",
                      "@wirecat/cli-messaging*/**",
                      "@mtcute/*",
                      "ws",
                      "**/telegram/**",
                      "**/max/**"
                    ],
                    "message": "cli-testing drives a CLI through its binary and its MCP server, never its code: what a CLI needs is config in that CLI's repository"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["performance/search/message-search/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "performance/search/matrix/results/**",
        "performance/search/matrix/fresh.json",
        "performance/search/matrix/models/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
